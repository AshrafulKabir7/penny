{
  "name": "penny",
  "productName": "Penny",
  "version": "0.1.0",
  "description": "Real-time graphics for AI: ask out loud, get diagrams and 3D scenes drawn right on your screen.",
  "main": "src/main/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "preview": "node tools/serve.mjs",
    "probe": "node tools/probe-models.mjs",
    "check-secrets": "node tools/check-secrets.mjs --history",
    "dist": "electron-builder --win nsis --x64 --publish never",
    "build:extension": "node tools/build-extension.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@fontsource/kalam": "^5.3.0",
    "@google/genai": "^2.32.0",
    "openai": "^7.47.0",
    "roughjs": "^4.6.6",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2"
  },
  "author": "Ashraful Kabir Alif",
  "homepage": "https://github.com/AshrafulKabir7/penny",
  "build": {
    "appId": "app.penny.desktop",
    "productName": "Penny",
    "copyright": "Penny contributors",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "package.json",
      "src/**",
      "voice/**",
      "!**/*.map"
    ],
    "asarUnpack": [
      "voice/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "artifactName": "Penny-Setup.${ext}",
      "shortcutName": "Penny",
      "deleteAppDataOnUninstall": false
    },
    "publish": [
      {
        "provider": "github",
        "owner": "AshrafulKabir7",
        "repo": "penny",
        "releaseType": "release"
      }
    ]
  }
}
