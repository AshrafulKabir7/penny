{
  "manifest_version": 3,
  "name": "Penny",
  "description": "Ask about the page you're on. Penny answers by drawing on it: notes, arrows, diagrams and 3D, using your own AI key.",
  "version": "0.1.0",
  "key": "",
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "action": {
    "default_title": "Ask Penny (Alt+Shift+P)",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png" }
  },
  "commands": {
    "_execute_action": { "suggested_key": { "default": "Alt+Shift+P" }, "description": "Ask Penny about this page" }
  },
  "background": { "service_worker": "background.js", "type": "module" },
  "options_page": "options.html",
  "permissions": ["activeTab", "scripting", "storage", "nativeMessaging"],
  "host_permissions": ["https://api.anthropic.com/*", "https://api.openai.com/*", "https://generativelanguage.googleapis.com/*"],
  "web_accessible_resources": [
    { "resources": ["overlay.html"], "matches": ["<all_urls>"] }
  ]
}
